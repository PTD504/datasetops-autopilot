DATABASE_URL=postgresql://postgres:password@localhost:5432/datasetops
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# --- Local Mock Demo ---
# For a fully deterministic demo without any external services:
# MOCK_LLM=true
# STORAGE_MODE=local

# --- Real Qwen Local Test ---
# For testing with the real Qwen model but local storage:
# docker compose passes these values into the backend container.
# MOCK_LLM=false
# RUN_MODE=real_test
# STORAGE_MODE=local
# (Ensure QWEN_API_KEY is provided below)

# --- Real OSS Local Test ---
# For testing local behavior but writing to real OSS:
# MOCK_LLM=true
# STORAGE_MODE=oss
# (Ensure ALIBABA_CLOUD_ACCESS_KEY_* variables are provided below)

# --- Final Alibaba Deployment ---
# For production/hackathon final deployment:
# MOCK_LLM=false
# ALLOW_LLM_FALLBACK=false # Strictly enforce real LLM or fail
# STORAGE_MODE=oss

# LLM Configuration
MOCK_LLM=true
ALLOW_LLM_FALLBACK=true
RUN_MODE=mock # mock, real_test, real_full. real_test/real_full select Qwen when QWEN_API_KEY is set.

# Qwen Budget Guardrails
# Users can also manually stop a workflow with POST /api/projects/{project_id}/stop.
# Cancellation is checked before guarded real Qwen calls.
QWEN_GUARDRAILS_ENABLED=true
QWEN_MAX_CALLS_PER_RUN=150
QWEN_MAX_INPUT_TOKENS_PER_RUN=100000
QWEN_MAX_OUTPUT_TOKENS_PER_RUN=20000
QWEN_MAX_TOTAL_TOKENS_PER_RUN=120000
QWEN_MAX_ESTIMATED_COST_USD_PER_RUN=1.0
# QWEN_MAX_SAMPLES_PER_REAL_RUN specifies the batch size per Qwen API call.
# A small batch size (like 1) ensures stable and structured JSON parser results.
QWEN_MAX_SAMPLES_PER_REAL_RUN=1
QWEN_MAX_REPAIR_ATTEMPTS_PER_SAMPLE=1
QWEN_STOP_ON_BUDGET_EXCEEDED=true

# Production Runtime Budget / Quota Guardrails (controls work size and LLM work limits)
# Set these to control maximum limits for workflows.
# BUDGET_GUARDRAIL_MODE can be: cap, strict, warn
MAX_SAMPLES_PER_RUN=50
MAX_REPAIR_RETRIES_PER_SAMPLE=1
MAX_LLM_CALLS_PER_WORKFLOW=150
BUDGET_GUARDRAIL_MODE=cap

QWEN_API_KEY=your_qwen_api_key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# Storage Configuration
STORAGE_MODE=local
LOCAL_STORAGE_DIR=backend/storage

ALIBABA_CLOUD_ACCESS_KEY_ID=your_access_key_id
ALIBABA_CLOUD_ACCESS_KEY_SECRET=your_access_key_secret
ALIBABA_CLOUD_OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
ALIBABA_CLOUD_OSS_BUCKET=your_bucket_name
ALIBABA_CLOUD_OSS_REGION=cn-hangzhou
