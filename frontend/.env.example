# Target Backend API URL for Server-Side Proxy Rewrites
# - Local Dev (without Docker): http://localhost:8000
# - Local Dev (with Docker compose): http://backend:8000
# - Vercel Production Deployment: Public URL of your backend (e.g., http://123.45.67.89:8000 or https://api.yourdomain.com)
BACKEND_URL=http://localhost:8000
